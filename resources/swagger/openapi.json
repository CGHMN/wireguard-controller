  "components": {
    "schemas": {
      "Server": {
        "title": "Wireguard server instance",
        "description": "Represents a Wireguard server instance on the host",
        "type": "object",
        "required": [
          "name",
          "interface_name",
          "private_key",
          "public_key",
          "endpoint",
          "listen_port",
          "mtu",
          "tunnel_ip",
          "routed_subnet"
        ],
        "properties": {
          "id": {
            "title": "ID",
            "description": "ID",
            "type": "integer",
            "example": 1,
            "readOnly": true
          },
          "name": {
            "title": "Instance Name",
            "description": "Human readable name of the server instance",
            "type": "string",
            "example": "Primary Wireguard Server"
          },
          "private_key": {
            "title": "Wireguard Private Key",
            "description": "Private Key of the Wireguard server instance",
            "type": "string",
            "format": "base64",
            "example": "cKka/80hKhH77QfqKX9FcmtoOICk4wH+sftB/j9Gi0Q="
          },
          "public_key": {
            "title": "Wireguard Public Key",
            "description": "Public Key of the Wireguard server instance",
            "type": "string",
            "format": "base64",
            "example": "Wg+je/GrQrDV6Ik8ffHwRP1GKKeip876lT+HQVKJ4A0="
          },
          "endpoint": {
            "title": "Endpoint Address",
            "description": "Hostname or IP address of the server instace",
            "type": "string",
            "example": "wg01.some.domain.tld"
          },
          "listen_port": {
            "title": "Listen Port",
            "description": "Port the server instace listens on",
            "type": "integer",
            "minimum": 1,
            "maximum": 65535,
            "example": 51820
          },
          "mtu": {
            "title": "Tunnel MTU Value",
            "description": "MTU value of the tunnel network interface",
            "type": "integer",
            "minimum": 68,
            "example": 1320
          },
          "tunnel_ip": {
            "title": "Inner Tunnel IP Address",
            "description": "IP address of the tunnel interface on the server side",
            "type": "string",
            "format": "ipv4",
            "example": "100.64.0.1/24"
          },
          "routed_subnet": {
            "title": "Routed Subnet Block",
            "description": "Subnet block from which smaller subnets are routed to peers",
            "type": "string",
            "format": "ipv4",
            "example": "100.65.0.0/16"
          }
        }
      },
      "ServerAllowedIp": {
        "title": "AllowedIP entry for a local Wireguard server instance in peer configuration",
        "description": "Represents an IP address or CIDR subnet peers of a Wireguard server instance will route towards the server through the tunnel",
        "type": "object",
        "required": [
          "cidr"
        ],
        "properties": {
          "id": {
            "title": "ID",
            "description": "ID",
            "type": "integer",
            "example": 1,
            "readOnly": true
          },
          "cidr": {
            "title": "IP CIDR",
            "description": "IP address or subnet in CIDR notation, single IPs can be written using /32",
            "type": "string",
            "format": "ipv4",
            "example": "100.64.0.0/10"
          },
          "server_id": {
            "title": "Server ID",
            "description": "ID of the server this AllowedIP entry belongs to",
            "type": "integer",
            "example": 1,
            "readOnly": true
          }
        }
      },
      "Peer": {
        "title": "Wireguard Peer",
        "description": "Represents a Wireguard Peer on a local Wireguard server instance",
        "type": "object",
        "required": [
          "name",
          "public_key",
          "tunnel_ip",
          "preshared_key"
        ],
        "properties": {
          "id": {
            "title": "ID",
            "description": "ID",
            "type": "integer",
            "example": 1,
            "readOnly": true
          },
          "name": {
            "title": "Name",
            "description": "Human readable peer name",
            "type": "string",
            "example": "John Doe CGHMN Router"
          },
          "public_key": {
            "title": "Wireguard Public Key",
            "description": "Public key of the Wireguard peer",
            "type": "string",
            "format": "base64",
            "example": "+2AEUd4r3usyz4Rw6Gh4gMD6BX9EhTTq0dYNblNUNGM="
          },
          "tunnel_ip": {
            "title": "Tunnel IP address",
            "description": "IP address of the peer inside the tunnel network in CIDR notation with /32",
            "type": "string",
            "format": "ipv4",
            "example": "100.64.0.2/32"
          },
          "user_id": {
            "title": "User ID",
            "description": "ID of the user this peer belongs to (not currently used)",
            "type": "integer",
            "nullable": true,
            "example": null
          },
          "server_id": {
            "title": "Server ID",
            "description": "ID of the server this peer belongs to",
            "type": "integer",
            "example": 1
          }
        }
      },
      "PeerAllowedIp": {
        "title": "AllowedIP entry for a peer",
        "description": "Represents an IP address or CIDR subnet the the server will route towards a peer",
        "type": "object",
        "required": [
          "cidr"
        ],
        "properties": {
          "id": {
            "title": "ID",
            "description": "ID",
            "type": "integer",
            "example": 1,
            "readOnly": true
          },
          "cidr": {
            "title": "IP CIDR",
            "description": "IP address or subnet in CIDR notation, single IPs can be written using /32",
            "type": "string",
            "format": "ipv4",
            "example": "100.65.2.0/24"
          },
          "peer_id": {
            "title": "Peer ID",
            "description": "ID of the peer this AllowedIP entry belongs to",
            "type": "integer",
            "example": 1,
            "readOnly": true
          }
        }
      },
      "array_of_ServerAllowedIp": {
        "title": "Array of AllowedIP entries for a Wireguard server instance",
        "type": "object",
        "properties": {
          "allowed_ips": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/ServerAllowedIp"
            }
          }
        }
      },
      "array_of_Peer": {
        "title": "Array of Peers",
        "type": "object",
        "properties": {
          "peers": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/Peer"
            }
          }
        }
      }
    },
    "securitySchemes": {
      "apiKeyAuth": {
        "type": "apiKey",
        "in": "header",
        "name": "X-API-Key"
      }
    }
  }
}