{
  "openapi": "3.0.0",
  "info": {
    "title": "CGHMN Wireguard Server API",
    "description": "This API offers a way to programmatically configure a live Wireguard server through HTTP calls.\n\nNote: Except for the `/servers/{server_id}/gen_new_peer` route, no other route automatically reloads the server on configuration changes!\n",
    "version": "1.0.1"
  },
  "security": [
    {
      "apiKeyAuth": []
    }
  ],
  "tags": [
    {
      "name": "Servers",
      "description": "Wireguard Server Instances"
    },
    {
      "name": "Peers",
      "description": "Wireguard Peers"
    },
    {
      "name": "Server AllowedIPs",
      "description": "AllowedIP entries for Wireguard server instances"
    },
    {
      "name": "Peer AllowedIPs",
      "description": "AllowedIP entries for Wireguard Peers"
    }
  ],
  "paths": {
    "/api/v1/servers": {
      "get": {
        "summary": "Get listing of all Wireguard server instances",
        "description": "Returns a list of all existing Wireguard server instances",
        "tags": [
          "Servers"
        ],
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "application/json": {
                "schema": {
                  "type": "array",
                  "items": {
                    "allOf": [
                      {
                        "$ref": "#/components/schemas/Server"
                      },
                      {
                        "$ref": "#/components/schemas/array_of_ServerAllowedIp"
                      }
                    ]
                  }
                }
              }
            }
          },
          "401": {
            "description": "Missing or invalid X-API-Key header"
          }
        }
      },
      "post": {
        "summary": "Create a new Wireguard server instance",
        "description": "Inserts a new Wireguard server instance, but does not reload the servers automatically",
        "tags": [
          "Servers"
        ],
        "requestBody": {
          "description": "Wireguard server instance data",
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/Server"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "OK, returns the full Wireguard server instance after instantiating the model",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Server"
                }
              }
            }
          },
          "401": {
            "description": "Missing or invalid X-API-Key header"
          }
        }
      }
    },
    "/api/v1/servers/{server_id}": {
      "get": {
        "summary": "Get single Wireguard server instance",
        "description": "Returns a single Wireguard server instance by its ID",
        "tags": [
          "Servers"
        ],
        "parameters": [
          {
            "name": "server_id",
            "in": "path",
            "description": "ID of the Wireguard server instance to get",
            "required": true,
            "schema": {
              "type": "integer",
              "example": 1
            }
          }
        ],
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "application/json": {
                "schema": {
                  "allOf": [
                    {
                      "$ref": "#/components/schemas/Server"
                    },
                    {
                      "$ref": "#/components/schemas/array_of_ServerAllowedIp"
                    },
                    {
                      "$ref": "#/components/schemas/array_of_Peer"
                    }
                  ]
                }
              }
            }
          },
          "401": {
            "description": "Missing or invalid X-API-Key header"
          },
          "404": {
            "description": "Wireguard server instance not found"
          }
        }
      },
      "put": {
        "summary": "Update a Wireguard server instance",
        "description": "Updates a Wireguard server instance",
        "tags": [
          "Servers"
        ],
        "parameters": [
          {
            "name": "server_id",
            "in": "path",
            "description": "ID of the Wireguard server instance to update",
            "required": true,
            "schema": {
              "type": "integer",
              "example": 1
            }
          }
        ],
        "requestBody": {
          "description": "Wireguard server instance data",
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/Server"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "OK, returns the Wireguard server instance",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Server"
                }
              }
            }
          },
          "401": {
            "description": "Missing or invalid X-API-Key header"
          },
          "404": {
            "description": "Wireguard server instance not found"
          }
        }
      },
      "delete": {
        "summary": "Delete a Wireguard server instance",
        "description": "Deletes an existing Wireguard server instance by its ID",
        "tags": [
          "Servers"
        ],
        "parameters": [
          {
            "name": "server_id",
            "in": "path",
            "description": "ID of the Wireguard server instance to delete",
            "required": true,
            "schema": {
              "type": "integer",
              "example": 1
            }
          }
        ],
        "responses": {
          "200": {
            "description": "OK, always returns true",
            "content": {
              "application/json": {
                "schema": {
                  "type": "boolean",
                  "enum": [
                    true
                  ],
                  "example": true
                }
              }
            }
          },
          "401": {
            "description": "Missing or invalid X-API-Key header"
          },
          "404": {
            "description": "Wireguard server instance not found"
          }
        }
      }
    },
